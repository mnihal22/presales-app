# Copy to .env (install.sh does this automatically)

# Secret used to sign login sessions. Set once; changing it logs everyone out.
JWT_SECRET=replace-with-a-long-random-string

# Port the app listens on
PORT=8787

# Directory where the SQLite database and uploaded vendor sheets are stored
DATA_DIR=./data

# Reserved for future Active Directory / LDAP integration
# AUTH_PROVIDER=local
